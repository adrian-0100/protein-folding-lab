.venv/
__pycache__/
.DS_Store
*.zip

# AlphaFold2 parameters: 3.7 GB, downloaded by the pipeline.
weights/

# Raw search output; the alignment that is actually used is kept in msa/.
experiments/*/msa/_search/

# ColabFold leftovers inside prediction folders: large intermediate files, and a
# copy of the input alignment in every output folder (the original is in msa/).
*.pickle
experiments/*/predictions/**/*.a3m

# Traces of a run on the remote GPU PC.
experiments/*/remote.log
experiments/*/.remote.*

# Machine-specific settings (address, logins, who has access, host identity), and key pairs
# generated for guests. Never commit private keys.
infra/remote-gpu-pc/remote.env
infra/remote-gpu-pc/authorized_keys
infra/remote-gpu-pc/known_hosts
infra/remote-gpu-pc/invites/

# Earlier runs kept on this machine only (see experiments/*/NOTEBOOK.md).
archive/

# Downloads shared between experiments (the ProteinGym archive).
data/

# Structures downloaded for a survey: hundreds of files, refetched by `select`.
experiments/*/selection/pdb/

# A mutant's alignment is the baseline's with one row changed: `msa` rebuilds it in a second.
experiments/*/msa/*.a3m
!experiments/*/msa/wt.a3m

# Private copies of template folders made for each prediction process.
experiments/*/predictions/**/_templates/

# What ColabFold's template search downloads, once per prediction process: the same structures
# every time. The ones it chose are named in each run's log.txt and *_template_domain_names.json.
experiments/*/predictions/**/*_all/

# Laboratory scans copied out of the ProteinGym archive: refetched by `prepare`.
experiments/*/truth/
