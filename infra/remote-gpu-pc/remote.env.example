# Copy to remote.env (gitignored) and fill in. Environment variables of the same name win.
REMOTE_HOST=192.168.1.50          # the remote's address on the local network
REMOTE_ADMIN=admin                # its administrator login (used only for admin-* and tunnel-*)
# REMOTE_PORT=22
# REMOTE_KEY=~/.ssh/id_ed25519
# REMOTE_TAILNET=my-machine.tailXXXX.ts.net   # optional: Tailscale name, administrator only
# REMOTE_JOBS=10
# REMOTE_PROBE_PORTS="3000 5432 8080"         # ports of services on the remote the guest must not reach
# REMOTE_MACHINE=remote-gpu-pc                # name recorded in provenance.json
